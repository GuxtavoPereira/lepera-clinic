{
  "name": "lepera-clinic",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @lepera/db migrate",
    "db:studio": "pnpm --filter @lepera/db studio",
    "db:seed": "pnpm --filter @lepera/db db:seed"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}