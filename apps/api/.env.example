PORT=3333
DATABASE_URL="postgresql://USUARIO:TROQUE_POR_SENHA_FORTE@localhost:5432/lepera_db?schema=public"
# Gere com: openssl rand -base64 32
JWT_SECRET="TROQUE_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES"
# Chave AES-256-GCM (64 caracteres hex). Gere com: openssl rand -hex 32
# Nunca troque em produção sem rotina de recriptografia dos registros existentes.
ENCRYPTION_KEY="TROQUE_POR_64_HEX_GERADOS_COM_OPENSSL_RAND_HEX_32"
WEB_URL="http://localhost:3000"
# Em produção atrás de proxy reverso (ex.: Vercel), defina 1 para IP real no rate limit.
TRUST_PROXY=0

# Opcional: cliente Web do Google Identity Services (ID público, não é o segredo).
GOOGLE_CLIENT_ID=

# Recuperação de senha via SMTP (ex.: Gmail com senha de app). Nunca commitar segredos reais.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
